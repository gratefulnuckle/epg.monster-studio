{
  "schema": "epg.monster.tools",
  "version": 2,
  "tools": [
    {
      "id": "ffmpeg",
      "label": "ffmpeg essentials",
      "destSubdir": "ffmpeg",
      "targets": [
        {
          "host": "windows-x86_64",
          "source": "system",
          "exeNames": ["ffmpeg.exe", "ffprobe.exe"],
          "installHint": "Install ffmpeg (includes ffprobe): winget install Gyan.FFmpeg   or   choco install ffmpeg   or   scoop install ffmpeg. Then run studio.ps1 --install."
        },
        {
          "host": "linux-x86_64",
          "source": "system",
          "exeNames": ["ffmpeg", "ffprobe"],
          "installHint": "Install ffmpeg from your package manager (Debian/Ubuntu/XFCE: sudo apt install ffmpeg · Fedora: sudo dnf install ffmpeg)."
        },
        {
          "host": "linux-aarch64",
          "source": "system",
          "exeNames": ["ffmpeg", "ffprobe"],
          "installHint": "Install ffmpeg from your package manager (e.g. sudo apt install ffmpeg)."
        },
        {
          "host": "macos-x86_64",
          "source": "system",
          "exeNames": ["ffmpeg", "ffprobe"],
          "installHint": "Install ffmpeg with Homebrew: brew install ffmpeg"
        },
        {
          "host": "macos-aarch64",
          "source": "system",
          "exeNames": ["ffmpeg", "ffprobe"],
          "installHint": "Install ffmpeg with Homebrew: brew install ffmpeg"
        }
      ]
    },
    {
      "id": "mpv",
      "label": "mpv",
      "destSubdir": "mpv",
      "optional": true,
      "targets": [
        {
          "host": "windows-x86_64",
          "source": "system",
          "optional": true,
          "exeNames": ["mpv.exe"],
          "installHint": "Optional. Set an mpv.exe path in Settings if you want Play to use mpv."
        },
        {
          "host": "linux-x86_64",
          "source": "system",
          "optional": true,
          "exeNames": ["mpv"],
          "installHint": "Optional. Set an mpv path in Settings if you want Play to use mpv."
        },
        {
          "host": "linux-aarch64",
          "source": "system",
          "optional": true,
          "exeNames": ["mpv"],
          "installHint": "Optional. Set an mpv path in Settings if you want Play to use mpv."
        },
        {
          "host": "macos-x86_64",
          "source": "system",
          "optional": true,
          "exeNames": ["mpv"],
          "installHint": "Optional. Set an mpv path in Settings if you want Play to use mpv."
        },
        {
          "host": "macos-aarch64",
          "source": "system",
          "optional": true,
          "exeNames": ["mpv"],
          "installHint": "Optional. Set an mpv path in Settings if you want Play to use mpv."
        }
      ]
    }
  ]
}
