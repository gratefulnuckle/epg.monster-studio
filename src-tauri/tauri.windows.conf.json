{
  "bundle": {
    "resources": {
      "windows/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./windows/sign.ps1 %1"
    }
  }
}
