{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "epg.monster studio",
  "version": "2.0.2",
  "identifier": "monster.epg.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "epg.monster studio",
        "width": 560,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#0C0C10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/mascot.ico", "icons/mascot.png", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "windows/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "copyright": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "epg.monster studio",
    "longDescription": "Desktop studio for curating IPTV playlists and presenting them as a local HDHomeRun tuner.",
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "ffmpeg"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
