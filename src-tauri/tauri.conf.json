{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "epg.monster studio",
  "version": "2.0.2",
  "identifier": "monster.epg.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "epg.monster studio",
        "width": 560,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#0C0C10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost http: https: data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost https://epg.monster https://my.epg.monster https://api.github.com; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/mascot.ico",
      "icons/mascot.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "GPL-3.0-or-later",
    "category": "Utility",
    "homepage": "https://epg.monster",
    "licenseFile": "../LICENSE",
    "publisher": "epg.monster",
    "shortDescription": "epg.monster studio",
    "longDescription": "Desktop studio for curating IPTV playlists and presenting them as a local HDHomeRun tuner.",
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "ffmpeg",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "recommends": ["mpv", "vlc"],
        "section": "utils",
        "desktopTemplate": "linux/epg.monster-studio.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
